@namespace Devity.Blazor
@inherits LocalizedComponentBase
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization

@if (_triggeredShow)
{
    <CascadingValue Value="this">
        <FocusTrap id="@Id"
                   Active="_shown"
                   Class="@OverlayCssClass"
                   data-active="@_shown.ToString()"
                   @attributes="AdditionalAttributes"
                   @onmousedown="CancelFromOverlay"
                   @onkeydown="OnKeyDown">
            <div role="dialog"
                 aria-modal="true"
                 aria-labelledby="@(string.IsNullOrWhiteSpace(Title) ? null : _titleId)"
                 data-active="@_shown.ToString()"
                 class="@DialogCssClass"
                 @onmousedown:stopPropagation="true">
                @if (ShowHeader)
                {
                    <section class="devity-dialog-header">
                        @if (HeaderContent is not null)
                        {
                            @HeaderContent
                        }
                        else
                        {
                            <h5 id="@_titleId" class="devity-dialog-title">@Title</h5>
                        }

                        @if (ShowCloseButton)
                        {
                            <button type="button" class="devity-dialog-close-button" title="@ResolvedCloseButtonTitle" aria-label="@ResolvedCloseButtonTitle" @onclick="Cancel">
                                @if (CloseButtonContent is not null)
                                {
                                    @CloseButtonContent
                                }
                                else
                                {
                                    <svg class="dv:size-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                            </button>
                        }
                    </section>
                }

                <section @ref="_body" class="devity-dialog-body" tabindex="-1">
                    @ChildContent
                </section>

                @if (ShowFooter)
                {
                    <section class="devity-dialog-footer">
                        @if (FooterContent is not null)
                        {
                            @FooterContent
                        }
                        else
                        {
                            <button type="button" class="devity-dialog-cancel-button" disabled="@_isSubmitting" @onclick="Cancel">@ResolvedCancelButtonText</button>
                            <button type="button" class="@(DangerSubmit ? "devity-dialog-submit-button devity-dialog-submit-button-danger" : "devity-dialog-submit-button")" disabled="@_isSubmitting" @onclick="Submit">
                                @if (_isSubmitting)
                                {
                                    <span class="devity-dialog-spinner" role="status" aria-label="@ResolvedLoadingLabel"></span>
                                }
                                else
                                {
                                    @ResolvedSubmitButtonText
                                }
                            </button>
                        }
                    </section>
                }
            </div>
        </FocusTrap>
    </CascadingValue>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    [Parameter]
    public RenderFragment? CloseButtonContent { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmitAttempted { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnShown { get; set; }

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter]
    public bool ShowFooter { get; set; } = true;

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public bool CloseOnOverlayClick { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool SubmitOnEnter { get; set; }

    [Parameter]
    public bool Large { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool DangerSubmit { get; set; }

    /// <summary>
    /// Overrides the localized default. Leave unset to use the current UI culture's translation
    /// (falls back to English if no <see cref="IStringLocalizer{T}"/> is registered by the host app).
    /// </summary>
    [Parameter]
    public string? CancelButtonText { get; set; }

    /// <inheritdoc cref="CancelButtonText"/>
    [Parameter]
    public string? SubmitButtonText { get; set; }

    /// <inheritdoc cref="CancelButtonText"/>
    [Parameter]
    public string? CloseButtonTitle { get; set; }

    [Parameter]
    public string OverlayClass { get; set; } = string.Empty;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public int AnimationMilliseconds { get; set; } = 200;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public bool IsOpen => _triggeredShow;
    public bool IsShown => _shown;
    public bool IsSubmitting => _isSubmitting;

    private bool _triggeredShow;
    private bool _shown;
    private bool _isSubmitting;
    private bool _hasOpenOverlay;
    private readonly string _titleId = $"devity-dialog-title-{Guid.NewGuid():N}";
    private ElementReference _body;

    private string ResolvedCancelButtonText => CancelButtonText ?? Localize("Cancel");
    private string ResolvedSubmitButtonText => SubmitButtonText ?? Localize("Submit");
    private string ResolvedCloseButtonTitle => CloseButtonTitle ?? Localize("Close");
    private string ResolvedLoadingLabel => Localize("Loading");

    private string OverlayCssClass => string.Join(' ', new[]
    {
        "devity-dialog-overlay",
        OverlayClass
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private string DialogCssClass => string.Join(' ', new[]
    {
        "devity-dialog-panel",
        FullWidth ? "devity-dialog-panel-full-width" : Large ? "devity-dialog-panel-large" : string.Empty,
        _hasOpenOverlay ? "devity-dialog-panel-overlay-open" : string.Empty,
        Class
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    public async Task Show()
    {
        if (!_triggeredShow)
        {
            _triggeredShow = true;
            _shown = false;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);
        }

        _shown = true;
        await InvokeAsync(StateHasChanged);
        await OnShown.InvokeAsync();
    }

    public async Task Close()
    {
        if (!_triggeredShow)
            return;

        _shown = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(AnimationMilliseconds);
        _triggeredShow = false;
        await InvokeAsync(StateHasChanged);
        await OnClose.InvokeAsync();
    }

    public async Task Cancel()
    {
        await OnCancel.InvokeAsync();
        await Close();
    }

    public async Task Submit()
    {
        if (_isSubmitting)
            return;

        _isSubmitting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await OnSubmitAttempted.InvokeAsync();
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Called by descendants (e.g. a <see cref="DevitySelect{TValue}"/>) that render their own
    /// overlay/dropdown inside the dialog body, so the dialog can temporarily stop clipping it.
    /// </summary>
    public void NotifyOverlayOpen(bool isOpen)
    {
        _hasOpenOverlay = isOpen;
        InvokeAsync(StateHasChanged);
    }

    private async Task CancelFromOverlay()
    {
        if (CloseOnOverlayClick)
            await Cancel();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape)
        {
            await Cancel();
            return;
        }

        if (e.Key == "Enter" && SubmitOnEnter)
        {
            await _body.FocusAsync();
            await Submit();
        }
    }

}
